{
  "name": "falcotech",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env dist/analog/server/index.mjs",
    "check": "ngc --noEmit -p tsconfig.app.json",
    "agents:sync": "agentyx sync",
    "agents:check": "agentyx doctor --locked --check",
    "test": "vitest run",
    "build:cloudflare": "BUILD_PRESET=cloudflare_module pnpm build",
    "preview:cloudflare": "wrangler dev",
    "images": "node scripts/images.mjs",
    "map": "node scripts/europe-map.mjs"
  },
  "dependencies": {
    "@analogjs/router": "2.9.7",
    "@angular/cdk": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-server": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@etyma/analog": "^1.0.0",
    "@etyma/angular": "^1.0.0",
    "@etyma/core": "^1.0.0",
    "@voltui/components": "^1.3.3",
    "angular-movement": "^1.2.0",
    "h3": "^1.15.0",
    "lumen-icons": "^0.3.1",
    "resend": "^4.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@agentyx/cli": "0.24.0",
    "@analogjs/platform": "2.9.7",
    "@angular/build": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/topojson-client": "^3.1.5",
    "@voltui/agent": "0.6.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.12",
    "postcss": "^8.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.166.0"
  }
