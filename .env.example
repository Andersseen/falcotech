# Resend API key used by POST /api/contact.
RESEND_API_KEY=

# Optional: sender and recipients. The sender's domain must be verified in Resend.
# CONTACT_FROM="FalcoTech Web <web@falcotech.es>"
# CONTACT_TO=info@falcotech.es

# Optional: Cloudflare Turnstile. Leave all three empty to run without the challenge.
# The sitekey is public and baked into the client build; the secret stays on the server.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Frontend hostnames this deployment accepts tokens from (comma separated). No localhost in production.
TURNSTILE_HOSTNAMES=
